# Allowlist: the build needs the module files and the Go packages, nothing
# else. Tests and their fixtures are left out too, so editing one does not
# rebuild the image.
*
!go.mod
!go.sum
# apps/: the farm app (make image-farm, deploy/k8s/local/farm.yaml), its web client prebuilt in webdist.
!apps/
!cmd/
!connectors/
!internal/
!pkg/
**/*_test.go
**/testdata/
