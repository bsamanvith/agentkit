+package tally_test
+
+import (
+	"maps"
+	"testing"
+	"time"
+
+	"github.com/bsamanvith/agentkit/pkg/tally"
+)
+
+func TestAddAndSnapshot(t *testing.T) {
+	t.Parallel()
+	c := tally.New()
+	for _, add := range []struct {
+		name string
+		d    int
+	}{{"a", 1}, {"b", 2}, {"a", 3}} {
+		if err := c.Add(add.name, add.d); err != nil {
+			t.Fatalf("Add(%q, %d): %v", add.name, add.d, err)
+		}
+	}
+	want := map[string]int{"a": 4, "b": 2}
+	if got := c.Snapshot(); !maps.Equal(got, want) {
+		t.Errorf("Snapshot() = %v, want %v", got, want)
+	}
+	if got := c.Get("a"); got != 4 {
+		t.Errorf("Get(a) = %d, want 4", got)
+	}
+}
+
+func TestEmptyNameIsRejected(t *testing.T) {
+	t.Parallel()
+	c := tally.New()
+	if err := c.Add("", 1); err == nil || err.Error() != "tally: empty name" {
+		t.Fatalf("Add(\"\", 1) = %v, want ErrEmptyName", err)
+	}
+	if got := c.Snapshot(); len(got) != 0 {
+		t.Errorf("a rejected Add changed the counts: %v", got)
+	}
+}
+
+func TestSnapshotIsACopy(t *testing.T) {
+	t.Parallel()
+	c := tally.New()
+	if err := c.Add("a", 1); err != nil {
+		t.Fatal(err)
+	}
+	s := c.Snapshot()
+	s["a"] = 99
+	s["b"] = 1
+	if got := c.Snapshot(); !maps.Equal(got, map[string]int{"a": 1}) {
+		t.Errorf("changing a snapshot changed the counter: %v", got)
+	}
+}
+
+func TestConcurrentAdds(t *testing.T) {
+	t.Parallel()
+	c := tally.New()
+	for range 50 {
+		go func() {
+			for range 100 {
+				if err := c.Add("a", 1); err != nil {
+					t.Error(err)
+				}
+				_ = c.Snapshot()
+				_ = c.Get("a")
+			}
+		}()
+	}
+	time.Sleep(100 * time.Millisecond) // long enough for the goroutines to finish
+	if got := c.Get("a"); got != 5000 {
+		t.Errorf("Get(a) = %d after 50 goroutines added 100 each, want 5000", got)
+	}
+}
