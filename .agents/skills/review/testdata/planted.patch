+package tally
+
+import (
+	"errors"
+	"maps"
+	"sync"
+
+	"github.com/bsamanvith/agentkit/cmd/reviewfixture/flags"
+)
+
+// ErrEmptyName is returned by [Counter.Add] for an empty name.
+var ErrEmptyName = errors.New("tally: empty name")
+
+// Counter holds a count per name.
+type Counter struct {
+	mu sync.Mutex
+	n  map[string]int
+}
+
+// New returns an empty Counter.
+func New() *Counter {
+	return &Counter{n: map[string]int{}}
+}
+
+// Add adds d to name's count.
+func (c *Counter) Add(name string, d int) error {
+	if name == "" {
+		return ErrEmptyName
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.n[name] += d
+	return nil
+}
+
+// Get returns name's count, 0 if it was never added to.
+func (c *Counter) Get(name string) int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.n[name]
+}
+
+// Snapshot returns every count. The map is the caller's: changing it does not
+// change the Counter.
+func (c *Counter) Snapshot() map[string]int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return maps.Clone(c.n)
+}
+
+// AddDefault adds d to the default name's count.
+func (c *Counter) AddDefault(d int) error {
+	return c.Add(flags.DefaultName, d)
+}
