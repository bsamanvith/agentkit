{
  "source": "A2A specification v1.0.0: docs/specification.md at tag v1.0.0 of github.com/a2aproject/A2A (https://a2a-protocol.org/v1.0.0/specification). Requests and responses are copied from the sections named, except where a note says otherwise. A request's placeholders (task-uuid, context-uuid, cursor-token, ...) are replaced with the IDs of the tasks the test made before it ('subst'). A response is matched by shape: every field of the spec's response is in ours, with the same value, except IDs, times and free text, and the paths in 'ignore'.",
  "examples": [
    {
      "name": "6.1-send",
      "section": "6.1 Basic Task Execution",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:send",
      "request": {
        "message": {
          "role": "ROLE_USER",
          "parts": [{"text": "What is the weather today?"}],
          "messageId": "msg-uuid"
        }
      },
      "status": 200,
      "response": {
        "task": {
          "id": "task-uuid",
          "contextId": "context-uuid",
          "status": {"state": "TASK_STATE_COMPLETED"},
          "artifacts": [{
            "artifactId": "artifact-uuid",
            "name": "Weather Report",
            "parts": [{"text": "Today will be sunny with a high of 75°F"}]
          }]
        }
      }
    },
    {
      "name": "6.2-stream",
      "section": "6.2 Streaming Task Execution",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:stream",
      "request": {
        "message": {
          "role": "ROLE_USER",
          "parts": [{"text": "Write a detailed report on climate change"}],
          "messageId": "msg-uuid"
        }
      },
      "status": 200,
      "stream": [
        {"task": {"id": "task-uuid", "status": {"state": "TASK_STATE_WORKING"}}},
        {"artifactUpdate": {"taskId": "task-uuid", "artifact": {"parts": [{"text": "# Climate Change Report\n\n"}]}}},
        {"statusUpdate": {"taskId": "task-uuid", "status": {"state": "TASK_STATE_COMPLETED"}}}
      ],
      "note": "Ours sends the answer again as its last chunk before the last status (section 11.7 allows more updates); the shape is matched item by item on the spec's three: the first, the first artifact update and the last."
    },
    {
      "name": "6.4-version",
      "section": "6.4 Version Negotiation Error",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:send",
      "headers": {"A2A-Version": "0.5"},
      "request": {
        "message": {
          "role": "ROLE_USER",
          "parts": [{"text": "Hello"}],
          "messageId": "msg-uuid"
        }
      },
      "status": 400,
      "reason": "VERSION_NOT_SUPPORTED",
      "note": "The spec's response here is an RFC 9457 problem document; section 11.6 makes the binding's errors AIP-193 objects with a google.rpc.ErrorInfo, which ours is. The status and the reason are checked."
    },
    {
      "name": "6.5-list-context",
      "section": "6.5 Task Listing and Management: all tasks from a specific context",
      "binding": "HTTP+JSON",
      "method": "GET",
      "path": "/tasks?contextId=c295ea44-7543-4f78-b524-7a38915ad6e4&pageSize=10&historyLength=3",
      "subst": {"c295ea44-7543-4f78-b524-7a38915ad6e4": "context"},
      "status": 200,
      "response": {
        "tasks": [
          {
            "id": "3f36680c-7f37-4a5f-945e-d78981fafd36",
            "contextId": "c295ea44-7543-4f78-b524-7a38915ad6e4",
            "status": {
              "state": "TASK_STATE_COMPLETED",
              "timestamp": "2024-03-15T10:15:00Z"
            }
          }
        ],
        "totalSize": 5,
        "pageSize": 10,
        "nextPageToken": ""
      },
      "ignore": ["totalSize"]
    },
    {
      "name": "6.5-list-working",
      "section": "6.5 Task Listing and Management: all working tasks across all contexts",
      "binding": "HTTP+JSON",
      "method": "GET",
      "path": "/tasks?status=TASK_STATE_WORKING&pageSize=20",
      "status": 200,
      "response": {
        "tasks": [
          {
            "id": "789abc-def0-1234-5678-9abcdef01234",
            "contextId": "another-context-id",
            "status": {
              "state": "TASK_STATE_WORKING",
              "message": {
                "role": "ROLE_AGENT",
                "parts": [
                  {
                    "text": "Processing your document analysis..."
                  }
                ],
                "messageId": "msg-status-update"
              },
              "timestamp": "2024-03-15T10:20:00Z"
            }
          }
        ],
        "totalSize": 1,
        "pageSize": 20,
        "nextPageToken": ""
      },
      "ignore": ["tasks.0.status.message"],
      "note": "A working task has no status message here: progress is the answer artifact, streamed."
    },
    {
      "name": "6.5-list-page",
      "section": "6.5 Task Listing and Management: pagination",
      "binding": "HTTP+JSON",
      "method": "GET",
      "path": "/tasks?contextId=c295ea44-7543-4f78-b524-7a38915ad6e4&pageSize=10&pageToken=base64-encoded-cursor-token",
      "subst": {"c295ea44-7543-4f78-b524-7a38915ad6e4": "bigContext", "base64-encoded-cursor-token": "secondPage"},
      "status": 200,
      "response": {
        "tasks": [],
        "totalSize": 15,
        "pageSize": 10,
        "nextPageToken": "base64-encoded-next-cursor-token"
      },
      "ignore": ["totalSize", "nextPageToken"],
      "note": "The spec's tasks array is a comment (/* ... additional tasks */), dropped to make it JSON."
    },
    {
      "name": "6.5-list-invalid",
      "section": "6.5 Task Listing and Management: validation error",
      "binding": "HTTP+JSON",
      "method": "GET",
      "path": "/tasks?pageSize=150&historyLength=-5&status=TASK_STATE_RUNNING",
      "status": 400,
      "note": "The spec's body is a problem document listing every field; ours is the AIP-193 error of section 11.6 and names the first. The status is checked."
    },
    {
      "name": "6.6-push",
      "section": "6.6 Push Notification Setup and Usage",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:send",
      "request": {
        "message": {
          "role": "ROLE_USER",
          "parts": [
            {
              "text": "Generate the Q1 sales report. This usually takes a while. Notify me when it's ready."
            }
          ],
          "messageId": "6dbc13b5-bd57-4c2b-b503-24e381b6c8d6"
        },
        "configuration": {
          "pushNotificationConfig": {
            "url": "https://client.example.com/webhook/a2a-notifications",
            "token": "secure-client-token-for-task-aaa",
            "authentication": {
              "schemes": ["Bearer"]
            }
          }
        }
      },
      "status": 400,
      "reason": "PUSH_NOTIFICATION_NOT_SUPPORTED",
      "note": "The agent card says pushNotifications: false, so the request is refused (section 3.3.4)."
    },
    {
      "name": "6.7-file",
      "section": "6.7 File Exchange (Upload and Download)",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:send",
      "request": {
        "message": {
          "role": "ROLE_USER",
          "parts": [
            {
              "text": "Analyze this image and highlight any faces."
            },
            {
              "raw": "iVBORw0KGgoAAAANSUhEUgAAAAUA...",
              "filename": "input_image.png",
              "mediaType": "image/png"
            }
          ],
          "messageId": "6dbc13b5-bd57-4c2b-b503-24e381b6c8d6"
        }
      },
      "status": 415,
      "reason": "CONTENT_TYPE_NOT_SUPPORTED",
      "note": "The spec's request has a missing and a trailing comma in the file part, fixed here. File parts are refused until the agent API takes files (T067)."
    },
    {
      "name": "6.8-data",
      "section": "6.8 Structured Data Exchange",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:send",
      "request": {
        "message": {
          "role": "ROLE_USER",
          "parts": [
            {
              "text": "Show me a list of my open IT tickets",
              "metadata": {
                "mediaType": "application/json",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ticketNumber": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          ],
          "messageId": "85b26db5-ffbb-4278-a5da-a7b09dea1b47"
        }
      },
      "status": 200,
      "response": {
        "task": {
          "id": "d8c6243f-5f7a-4f6f-821d-957ce51e856c",
          "contextId": "c295ea44-7543-4f78-b524-7a38915ad6e4",
          "status": {
            "state": "TASK_STATE_COMPLETED",
            "timestamp": "2025-04-17T17:47:09.680794Z"
          },
          "artifacts": [
            {
              "artifactId": "c5e0382f-b57f-4da7-87d8-b85171fad17c",
              "parts": [
                {
                  "text": "[{\"ticketNumber\":\"REQ12312\",\"description\":\"request for VPN access\"},{\"ticketNumber\":\"REQ23422\",\"description\":\"Add to DL - team-gcp-onboarding\"}]"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "8.5-card",
      "section": "8.5 Sample Agent Card",
      "binding": "card",
      "method": "GET",
      "path": "/.well-known/agent-card.json",
      "status": 200,
      "response": {
        "name": "GeoSpatial Route Planner Agent",
        "description": "Provides advanced route planning, traffic analysis, and custom map generation services. This agent can calculate optimal routes, estimate travel times considering real-time traffic, and create personalized maps with points of interest.",
        "supportedInterfaces": [
          {"url": "https://georoute-agent.example.com/a2a/v1", "protocolBinding": "JSONRPC", "protocolVersion": "1.0"},
          {"url": "https://georoute-agent.example.com/a2a/grpc", "protocolBinding": "GRPC", "protocolVersion": "1.0"},
          {"url": "https://georoute-agent.example.com/a2a/json", "protocolBinding": "HTTP+JSON", "protocolVersion": "1.0"}
        ],
        "provider": {
          "organization": "Example Geo Services Inc.",
          "url": "https://www.examplegeoservices.com"
        },
        "iconUrl": "https://georoute-agent.example.com/icon.png",
        "version": "1.2.0",
        "documentationUrl": "https://docs.examplegeoservices.com/georoute-agent/api",
        "capabilities": {
          "streaming": true,
          "pushNotifications": true,
          "stateTransitionHistory": false,
          "extendedAgentCard": true
        },
        "securitySchemes": {
          "google": {
            "openIdConnectSecurityScheme": {
              "openIdConnectUrl": "https://accounts.google.com/.well-known/openid-configuration"
            }
          }
        },
        "security": [{ "google": ["openid", "profile", "email"] }],
        "defaultInputModes": ["application/json", "text/plain"],
        "defaultOutputModes": ["application/json", "image/png"],
        "skills": [
          {
            "id": "route-optimizer-traffic",
            "name": "Traffic-Aware Route Optimizer",
            "description": "Calculates the optimal driving route between two or more locations, taking into account real-time traffic conditions, road closures, and user preferences (e.g., avoid tolls, prefer highways).",
            "tags": ["maps", "routing", "navigation", "directions", "traffic"],
            "examples": [
              "Plan a route from '1600 Amphitheatre Parkway, Mountain View, CA' to 'San Francisco International Airport' avoiding tolls.",
              "{\"origin\": {\"lat\": 37.422, \"lng\": -122.084}, \"destination\": {\"lat\": 37.7749, \"lng\": -122.4194}, \"preferences\": [\"avoid_ferries\"]}"
            ],
            "inputModes": ["application/json", "text/plain"],
            "outputModes": [
              "application/json",
              "application/vnd.geo+json",
              "text/html"
            ]
          }
        ],
        "signatures": [
          {
            "protected": "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpPU0UiLCJraWQiOiJrZXktMSIsImprdSI6Imh0dHBzOi8vZXhhbXBsZS5jb20vYWdlbnQvandrcy5qc29uIn0",
            "signature": "QFdkNLNszlGj3z3u0YQGt_T9LixY3qtdQpZmsTdDHDe3fXV9y9-B3m2-XgCpzuhiLt8E0tV6HXoZKHv4GtHgKQ"
          }
        ]
      },
      "ignore": [
        "supportedInterfaces.1", "supportedInterfaces.2", "provider", "iconUrl", "documentationUrl",
        "capabilities.pushNotifications", "capabilities.stateTransitionHistory", "capabilities.extendedAgentCard",
        "securitySchemes.google", "security", "defaultInputModes", "defaultOutputModes",
        "skills.0.tags", "skills.0.examples", "skills.0.inputModes", "skills.0.outputModes", "signatures"
      ],
      "note": "The sample's second skill is dropped. Its values are another agent's: the matched fields are the card's structure (name, description, interfaces with binding and version, version, capabilities.streaming, skills with id, name and description). Ours has no gRPC interface, no push notifications, no extended card, no signature, and securitySchemes of the server's own auth (checked in TestAgentCard). The sample's 'security' is not a field of the v1.0 proto (securityRequirements is)."
    },
    {
      "name": "9.4.1-SendMessage",
      "section": "9.4.1 SendMessage, with the SendMessageRequest of 6.1",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "SendMessage",
        "params": {
          "message": {
            "role": "ROLE_USER",
            "parts": [{"text": "What is the weather today?"}],
            "messageId": "msg-uuid"
          }
        }
      },
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "task": {
            "id": "task-uuid",
            "contextId": "context-uuid",
            "status": {"state": "TASK_STATE_COMPLETED"}
          }
        }
      }
    },
    {
      "name": "9.4.2-SendStreamingMessage",
      "section": "9.4.2 SendStreamingMessage, with the SendMessageRequest of 6.2",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "SendStreamingMessage",
        "params": {
          "message": {
            "role": "ROLE_USER",
            "parts": [{"text": "Write a detailed report on climate change"}],
            "messageId": "msg-uuid"
          }
        }
      },
      "status": 200,
      "stream": [
        {"jsonrpc": "2.0", "id": 1, "result": {"task": {"id": "task-uuid", "status": {"state": "TASK_STATE_WORKING"}}}},
        {"jsonrpc": "2.0", "id": 1, "result": {"artifactUpdate": {"taskId": "task-uuid", "artifact": {"parts": [{"text": "# Climate Change Report\n\n"}]}}}},
        {"jsonrpc": "2.0", "id": 1, "result": {"statusUpdate": {"taskId": "task-uuid", "status": {"state": "TASK_STATE_COMPLETED"}}}}
      ],
      "note": "Section 9.4.2 shows the stream's framing only; the items are those of 6.2 in it."
    },
    {
      "name": "9.4.3-GetTask",
      "section": "9.4.3 GetTask",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "GetTask",
        "params": {
          "id": "task-uuid",
          "historyLength": 10
        }
      },
      "subst": {"task-uuid": "task"},
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "id": "task-uuid",
          "contextId": "context-uuid",
          "status": {"state": "TASK_STATE_COMPLETED"},
          "artifacts": [{"artifactId": "artifact-uuid", "parts": [{"text": "..."}]}]
        }
      },
      "note": "Section 9.4.3 shows the request only; the response is a Task (3.1.3), here the task 6.1 made."
    },
    {
      "name": "9.4.4-ListTasks",
      "section": "9.4.4 ListTasks",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "ListTasks",
        "params": {
          "contextId": "context-uuid",
          "status": "TASK_STATE_WORKING",
          "pageSize": 50,
          "pageToken": "cursor-token"
        }
      },
      "subst": {"context-uuid": "waitingContext", "cursor-token": "firstPage"},
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "tasks": [{"id": "task-uuid", "contextId": "context-uuid", "status": {"state": "TASK_STATE_WORKING"}}],
          "totalSize": 1,
          "pageSize": 50,
          "nextPageToken": ""
        }
      },
      "note": "Section 9.4.4 shows the request only; the response is a ListTasksResponse (3.1.4) with the one working task of the context."
    },
    {
      "name": "9.4.6-SubscribeToTask",
      "section": "9.4.6 SubscribeToTask",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "SubscribeToTask",
        "params": {
          "id": "task-uuid"
        }
      },
      "subst": {"task-uuid": "waitingTask"},
      "status": 200,
      "stream": [
        {"jsonrpc": "2.0", "id": 5, "result": {"task": {"id": "task-uuid", "status": {"state": "TASK_STATE_WORKING"}}}},
        {"jsonrpc": "2.0", "id": 5, "result": {"statusUpdate": {"taskId": "task-uuid", "status": {"state": "TASK_STATE_CANCELED"}}}}
      ],
      "note": "The task waits; the test cancels it once the stream has its first item, so the stream ends canceled."
    },
    {
      "name": "9.4.5-CancelTask",
      "section": "9.4.5 CancelTask",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "CancelTask",
        "params": {
          "id": "task-uuid"
        }
      },
      "subst": {"task-uuid": "otherWaitingTask"},
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {"id": "task-uuid", "contextId": "context-uuid", "status": {"state": "TASK_STATE_CANCELED"}}
      },
      "note": "Section 9.4.5 shows the request only; the response is the updated Task (3.1.5)."
    },
    {
      "name": "9.4.8-GetExtendedAgentCard",
      "section": "9.4.8 GetExtendedAgentCard",
      "binding": "JSONRPC",
      "request": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "GetExtendedAgentCard"
      },
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 6,
        "error": {"code": -32004, "message": "...", "data": [{"@type": "type.googleapis.com/google.rpc.ErrorInfo", "reason": "UNSUPPORTED_OPERATION", "domain": "a2a-protocol.org"}]}
      },
      "note": "The card says extendedAgentCard: false, so this is UnsupportedOperationError (3.3.4)."
    },
    {
      "name": "9.5-method-not-found",
      "section": "9.5 Error Handling: error response structure",
      "binding": "JSONRPC",
      "request": {"jsonrpc": "2.0", "id": 1, "method": "invalid/method", "params": {}},
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "error": {
          "code": -32601,
          "message": "Method not found",
          "data": {
            "method": "invalid/method"
          }
        }
      },
      "ignore": ["error.data"],
      "note": "The spec's request is not shown; this one calls the method its response names. Ours has no data for JSON-RPC's own errors."
    },
    {
      "name": "9.5-task-not-found",
      "section": "9.5 Error Handling: A2A-specific error response",
      "binding": "JSONRPC",
      "request": {"jsonrpc": "2.0", "id": 2, "method": "GetTask", "params": {"id": "nonexistent-task-id"}},
      "status": 200,
      "response": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": {
          "code": -32001,
          "message": "Task not found",
          "data": [
            {
              "@type": "type.googleapis.com/google.rpc.ErrorInfo",
              "reason": "TASK_NOT_FOUND",
              "domain": "a2a-protocol.org",
              "metadata": {
                "taskId": "nonexistent-task-id",
                "timestamp": "2025-11-09T10:30:00.000Z"
              }
            }
          ]
        }
      },
      "note": "The spec's request is not shown; this one asks for the task its response names."
    },
    {
      "name": "11.4-send",
      "section": "11.4 Request/Response Format",
      "binding": "HTTP+JSON",
      "method": "POST",
      "path": "/message:send",
      "request": {
        "message": {
          "messageId": "uuid",
          "role": "ROLE_USER",
          "parts": [{"text": "Hello"}]
        },
        "configuration": {
          "acceptedOutputModes": ["text/plain"]
        }
      },
      "status": 200,
      "response": {
        "task": {
          "id": "task-uuid",
          "contextId": "context-uuid",
          "status": {
            "state": "TASK_STATE_COMPLETED"
          }
        }
      }
    },
    {
      "name": "11.6-not-found",
      "section": "11.6 Error Handling",
      "binding": "HTTP+JSON",
      "method": "GET",
      "path": "/tasks/task-123",
      "status": 404,
      "response": {
        "error": {
          "code": 404,
          "status": "NOT_FOUND",
          "message": "The specified task ID does not exist or is not accessible",
          "details": [
            {
              "@type": "type.googleapis.com/google.rpc.ErrorInfo",
              "reason": "TASK_NOT_FOUND",
              "domain": "a2a-protocol.org",
              "metadata": {
                "taskId": "task-123",
                "timestamp": "2025-11-09T10:30:00.000Z"
              }
            }
          ]
        }
      },
      "note": "The spec's request is not shown; this one asks for the task its response names."
    }
  ]
}
